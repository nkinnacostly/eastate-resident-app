*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# Local tooling cache
.openvisio/

# Markdown stays local, never in the repo.
#
# Supersedes the individual CLAUDE.md / PRD / technical-design entries that
# used to live here — `*.md` already covers them. Note that ignoring a file
# does nothing once it is tracked, which is why CLAUDE.md sat in this list and
# in git at the same time; anything added here also needs `git rm --cached`.
*.md


# Firebase / FCM push credentials.
#
# `google-services.json` is NOT here on purpose: its API key is package-
# restricted and the file ships inside the APK, so it is config, not a secret,
# and a fresh clone needs it to build.
#
# The FCM V1 *service account key* is the opposite — a private key that can
# send to every device on the project. It is uploaded to EAS (`eas
# credentials`) and must never enter the repo. Firebase names the download
# `<project>-firebase-adminsdk-<hash>.json`; the patterns below cover that and
# the names people rename it to.
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json
google-service-account*.json
fcm-v1*.json


# EAS local signing credentials — holds keystore and key passwords in
# plaintext. The keystores themselves are already covered by *.jks above;
# this is the file that would leak the passwords to open them.
credentials.json

