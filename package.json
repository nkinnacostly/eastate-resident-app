{
  "name": "estate-access",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push",
    "db:advisors": "supabase db advisors --linked",
    "test:db": "supabase db query -f supabase/tests/invariants.sql --linked",
    "test:db:teardown": "supabase db query -f supabase/tests/teardown.sql --linked",
    "db:types": "node scripts/gen-types.mjs --linked",
    "db:types:local": "node scripts/gen-types.mjs --local",
    "resident": "npm run start --workspace @estate/resident",
    "guard": "npm run start --workspace @estate/guard",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "supabase": "^2.114.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0"
  }
}