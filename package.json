{
  "name": "estate-access",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push",
    "db:advisors": "supabase db advisors --linked",
    "test:db": "supabase db query -f supabase/tests/invariants.sql --linked",
    "test:db:teardown": "supabase db query -f supabase/tests/teardown.sql --linked",
    "db:types": "node scripts/gen-types.mjs --linked",
    "db:types:local": "node scripts/gen-types.mjs --local",
    "resident": "npm run start --workspace @estate/resident",
    "guard": "npm run start --workspace @estate/guard",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc --noEmit -p apps/guard/tsconfig.json && tsc --noEmit -p apps/resident/tsconfig.json && npm run typecheck --workspace @estate/web",
    "//typecheck": "Runs in every workspace. Added because nothing repo-wide ran the web typecheck, so a broken one shipped: apps/web/tsconfig.json is a solution file, which makes `tsc --noEmit` there check ZERO files and always pass. Only `tsc -b` type-checks it.",
    "test": "npm run test --workspaces --if-present",
    "test:csv": "node scripts/test-csv.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "test:db:delivery": "supabase db query -f supabase/tests/delivery.sql --linked",
    "test:migrations": "node scripts/test-migration.mjs supabase/tests/schema-harness.sql supabase/migrations/20260926100000_retention.sql supabase/migrations/20260926110000_agencies.sql supabase/migrations/20260926120000_psira_return.sql supabase/migrations/20260926130000_agency_writes.sql supabase/migrations/20260926140000_agency_reporting.sql supabase/migrations/20260926150000_revoke_trigger_functions.sql supabase/tests/retention.sql supabase/tests/agencies.sql",
    "test:dues": "node scripts/test-migration.mjs supabase/tests/schema-harness.sql supabase/migrations/20260927100000_estate_dues.sql supabase/migrations/20260927110000_dues_functions.sql supabase/migrations/20260927120000_dues_payments.sql supabase/migrations/20260927130000_dues_enforcement_authority.sql supabase/migrations/20260927140000_dues_reconcile_cron.sql supabase/migrations/20260927150000_revoke_dues_in_arrears.sql supabase/migrations/20260927160000_dues_landlord_contact.sql supabase/migrations/20260927170000_set_dues_config.sql supabase/migrations/20260927180000_dues_reminders.sql supabase/migrations/20260927190000_estate_settlement.sql supabase/migrations/20260927200000_dues_split_payments.sql supabase/tests/dues.sql",
    "test:settlement": "node scripts/test-migration.mjs supabase/tests/schema-harness.sql supabase/migrations/20260927100000_estate_dues.sql supabase/migrations/20260927110000_dues_functions.sql supabase/migrations/20260927120000_dues_payments.sql supabase/migrations/20260927130000_dues_enforcement_authority.sql supabase/migrations/20260927140000_dues_reconcile_cron.sql supabase/migrations/20260927150000_revoke_dues_in_arrears.sql supabase/migrations/20260927160000_dues_landlord_contact.sql supabase/migrations/20260927170000_set_dues_config.sql supabase/migrations/20260927180000_dues_reminders.sql supabase/migrations/20260927190000_estate_settlement.sql supabase/migrations/20260927200000_dues_split_payments.sql supabase/tests/settlement.sql",
    "test:flutterwave": "node --no-warnings scripts/test-flutterwave.mjs"
  },
  "devDependencies": {
    "supabase": "^2.114.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0"
  },
  "//typecheck": "Driven from the ROOT for the mobile apps, never from their own package.json. @expo/fingerprint hashes packageJson:scripts, so adding a script there changes the runtimeVersion under the fingerprint policy -- which silently strands every OTA update, because EAS matches updates to builds on runtimeVersion. A dev-only line must not be able to do that. apps/web keeps its own script because tsconfig.json there is a solution file and only `tsc -b` checks it."
}
